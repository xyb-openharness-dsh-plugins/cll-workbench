{
  "name": "@xyb-community/cll-workbench",
  "version": "0.4.0",
  "description": "CLL/SLL 患者与照护者的本机病程资料工作台：Watch & Wait 观察轨道与 ALC 倍增趋势、治疗触发词表、FISH/TP53/IGHV 基因预后档案与三档临床匹配、口服药日志与 MRD 里程碑、分系列指标卡",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "schema",
    "public",
    "demo"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:version": "node scripts/build-version.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-host-contract.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-derivative-leftovers.mjs . && node scripts/check-version.mjs && node scripts/smoke-activate.mjs && node --test test/*.test.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "smoke:activate": "node scripts/smoke-activate.mjs",
    "verify:desktop": "node scripts/verify-desktop-load.mjs",
    "start": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run test && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "check:leftovers": "node scripts/check-derivative-leftovers.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/cll-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}